# Cloudflare R2 — used ONLY by scripts/ingest-media.mjs on your machine.
# Do NOT set these in Netlify; the deployed site needs no R2 access.
# (Media is served from public R2 URLs already pasted into now/page.mdx.)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dhen-media
# Public read base for finished URLs — no trailing slash.
# Custom domain (https://media.example.com) or the bucket's pub-*.r2.dev URL.
R2_PUBLIC_BASE_URL=https://media.example.com

# Unrelated existing var, kept for reference:
NEXT_PUBLIC_LOCATION="Tokyo"
